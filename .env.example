# ===================================================
# ECE Capstone Project Management System - Environment Variables
# ===================================================

# Database (Supabase / Neon Postgres)
# Pooled connection string (used by Next.js app in production)
DATABASE_URL="postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection string (used by Prisma CLI for migrations & db push)
DIRECT_URL="postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Authentication (Auth.js / NextAuth v5)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
APP_BASE_URL="http://localhost:3000"

# Application Encryption Key (32 random bytes, base64-encoded for AES-256-GCM AI provider keys)
APP_ENCRYPTION_KEY="generate-with-node-crypto-randomBytes-32-base64"

# Email Delivery (Resend or Gmail SMTP)
RESEND_API_KEY="re_123456789"
MAIL_FROM="ECE Project Committee <projects-ece@heritageit.edu>"

# Vercel Cron Security Secret (for /api/cron/reminders)
CRON_SECRET="generate-with-openssl-rand-hex-32"

# Initial Seed Admin Account (used on initial prisma db seed)
INITIAL_ADMIN_EMAIL="admin.project@heritageit.edu"
INITIAL_ADMIN_NAME="Project Committee Chair"
INITIAL_ADMIN_PASSWORD="ChangeMeOnFirstLogin2026!"
