# ========================================================
# ECE Capstone Project Management System - Environment Variables
# Heritage Institute of Technology, Kolkata (B.Tech ECE)
# ========================================================

# 1. Database Connections (PostgreSQL / Supabase / Neon)
# Pooled connection string (Port 6543 with pgbouncer for serverless)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true"
# Direct connection string (Port 5432 for migrations and schema sync)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# 2. Authentication & Session Security (Auth.js / NextAuth v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET="7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b"
APP_BASE_URL="http://localhost:3000"

# 3. AES-256-GCM Encryption Key (For encrypting AI provider API keys at rest)
# Generate with: openssl rand -hex 32 (Must be exactly 64 hex characters)
APP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# 4. Automated Reminders & Vercel Cron Security
# Bearer secret token used by Vercel Cron to trigger /api/cron/reminders
CRON_SECRET="ece-hitk-capstone-cron-secret-2026"

# 5. Email Notifications (Resend API)
RESEND_API_KEY="re_sample_api_key_here"
MAIL_FROM="susovan.mandal@heritageit.edu"

# 6. Default Admin Account (Used on initial seed)
INITIAL_ADMIN_EMAIL="admin.project@heritageit.edu"
INITIAL_ADMIN_NAME="Project Committee Admin"
INITIAL_ADMIN_PASSWORD="AdminPass@2026"
